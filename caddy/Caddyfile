# TLS + password front for the console on a public VPS.
# Caddy auto-provisions a Let's Encrypt certificate for $RAS_PUBLIC_HOST (must be a real domain
# whose A/AAAA record points at this VPS) and gates everything behind one shared password.
#
# This is deliberately a thin, swappable layer: to move to GitHub/Google login later, replace the
# `basic_auth` block with an `oauth2-proxy` (forward_auth) — the `reverse_proxy console:80` target
# stays the same. Multi-tenant, per-user device lists are a later, backend-level change.
{
	email {$ACME_EMAIL}
}

{$RAS_PUBLIC_HOST} {
	encode gzip
	# One shared operator password (single-tenant). Generate the hash with:
	#   docker run --rm caddy caddy hash-password --plaintext 'your-password'
	basic_auth {
		{$CONSOLE_USER} {$CONSOLE_PASSWORD_HASH}
	}
	reverse_proxy console:80
}
